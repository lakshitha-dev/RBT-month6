        <mxCell id="b" value="Feed Service&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;[Container: Node.js / Express]&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=2;absoluteArcSize=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=4;fontStyle=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="255" y="245" width="890" height="553" as="geometry"/></mxCell>
