        <mxCell id="api" value="&lt;b style=&quot;font-size:13px&quot;&gt;Feed API Controller&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Express route]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;GET /feed - identity, limit, cursor&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="270" width="180" height="100" as="geometry"/></mxCell>
