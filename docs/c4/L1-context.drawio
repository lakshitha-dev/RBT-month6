<mxfile host="app.diagrams.net" type="device">
  <diagram id="L1-context" name="SocialFlow - System Context (C4 Level 1)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="SocialFlow - System Context (C4 Level 1)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="15" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="mod" value="&lt;b style=&quot;font-size:13px&quot;&gt;Moderator / Admin&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Reviews reported content, manages accounts&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b style=&quot;font-size:13px&quot;&gt;Social Media User&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Posts, follows, reads feed, chats (iOS, Android, web)&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=30;fillColor=#08427B;strokeColor=#073B6F;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="80" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="sf" value="&lt;b style=&quot;font-size:13px&quot;&gt;SocialFlow Platform&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Software System]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Profiles, posts, personalised feed, likes/comments, notifications, DMs, search, moderation&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="230" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="oauth" value="&lt;b style=&quot;font-size:13px&quot;&gt;Identity Providers&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System: Google, Facebook]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;OAuth 2.0 / OIDC sign-in&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="email" value="&lt;b style=&quot;font-size:13px&quot;&gt;Email Service&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System: Amazon SES]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Verification, digests, GDPR exports&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="530" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="sms" value="&lt;b style=&quot;font-size:13px&quot;&gt;SMS Service&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System: Twilio]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Phone verification, 2FA&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="530" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="push" value="&lt;b style=&quot;font-size:13px&quot;&gt;Push Notifications&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System: APNs, FCM]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Mobile push delivery&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="analytics" value="&lt;b style=&quot;font-size:13px&quot;&gt;Analytics Platform&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Product analytics (consented events)&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="530" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="pay" value="&lt;b style=&quot;font-size:13px&quot;&gt;Payment Gateway&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System: Stripe]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Premium subscriptions&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="530" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="cdn" value="&lt;b style=&quot;font-size:13px&quot;&gt;CDN&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[External System: Amazon CloudFront]&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:6px&quot;&gt;Edge delivery of media &amp; web assets&lt;/div&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="230" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="e0" value="Uses&lt;br&gt;&lt;i&gt;[HTTPS / WSS]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="user" target="sf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="Moderates content&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="mod" target="sf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2" value="Downloads media&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="user" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="Publishes media to&lt;br&gt;&lt;i&gt;[S3 origin]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="cdn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="Authenticates users with&lt;br&gt;&lt;i&gt;[OIDC]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="oauth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="Sends email via&lt;br&gt;&lt;i&gt;[HTTPS API]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e6" value="Sends SMS via&lt;br&gt;&lt;i&gt;[HTTPS API]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="sms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e7" value="Sends push via&lt;br&gt;&lt;i&gt;[HTTPS/2]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="push"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e8" value="Streams events to&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="analytics"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e9" value="Charges via / webhooks&lt;br&gt;&lt;i&gt;[HTTPS]&lt;/i&gt;" style="html=1;endArrow=blockThin;endFill=1;endSize=10;strokeColor=#707070;fontColor=#404040;fontSize=10;labelBackgroundColor=#ffffff;rounded=1;edgeStyle=none;" edge="1" parent="1" source="sf" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;■ dark blue: person&lt;br&gt;■ blue: container / system&lt;br&gt;■ light blue: component&lt;br&gt;■ grey: external system&lt;br&gt;- - dashed: boundary" style="text;html=1;fontSize=11;align=left;verticalAlign=top;strokeColor=#cccccc;fillColor=#fafafa;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="200" height="100" as="geometry"/></mxCell>
