@startuml L2-container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam nodesep 40
skinparam ranksep 60
title SocialFlow - Container Diagram (C4 Level 2)

Person(user, "Social Media User", "Mobile & web")

System_Boundary(sf, "SocialFlow Platform") {
  Boundary(clients, "Clients") {
    Container(spa, "Web Application", "React SPA", "Browser client served from the CDN")
    Container(mobile, "Mobile Apps", "Swift / Kotlin", "iOS and Android clients")
  }

  Boundary(edge, "Edge") {
    Container(gateway, "API Gateway", "Kong (DB-less)", "Routing, JWT auth, rate limiting, CORS, correlation id")
    Container(ws, "WebSocket Gateway", "Node.js", "Persistent connections for notifications and DMs")
    Container(registry, "Service Registry", "Consul", "Registration, health checks, DNS discovery")
  }

  Boundary(core, "Core services (POC: User, Post, Feed)") {
    Container(userSvc, "User Service", "Node.js / Express", "Accounts, profiles, OAuth linking, follow graph")
    Container(postSvc, "Post Service", "Node.js / Express", "Posts, likes, comments, shares; transactional outbox")
    Container(feedSvc, "Feed Service", "Node.js / Express", "Fan-out worker, timeline cache, personalised ranking")
  }

  Boundary(supporting, "Supporting services") {
    Container(msgSvc, "Message Service", "Node.js", "Direct and group messaging, receipts")
    Container(notifSvc, "Notification Service", "Node.js", "In-app, push, email and SMS")
    Container(mediaSvc, "Media Service", "Go", "Presigned uploads, transcoding, thumbnails")
    Container(searchSvc, "Search Service", "Node.js", "Users, posts, hashtags")
    Container(modSvc, "Moderation Service", "Python", "Classification, report queue, takedowns")
    Container(billingSvc, "Billing Service", "Node.js", "Premium subscriptions, Stripe webhooks, entitlements")
  }

  Boundary(data, "Data & events") {
    ContainerQueue(kafka, "Event Bus", "Apache Kafka", "post.*, user.*, message.sent, subscription.*, user.deleted")
    ContainerDb(pg, "Relational DB", "PostgreSQL", "Database per service: users, posts, feed, media, moderation, billing")
    ContainerDb(redis, "Cache", "Redis Cluster", "Timelines, post cache, counters, WS routing")
    ContainerDb(cassandra, "Wide-column Store", "Cassandra", "Durable timelines, messages, notifications")
    ContainerDb(es, "Search Index", "Elasticsearch", "Users, posts, hashtags")
    ContainerDb(s3, "Media Storage", "Amazon S3", "Images and video renditions")
  }
}

System_Ext(cdn, "CDN", "CloudFront")
System_Ext(oauth, "Identity Providers", "Google, Facebook")
System_Ext(push, "Push / Email / SMS", "APNs, FCM, SES, Twilio")
System_Ext(payment, "Payment Gateway", "Stripe")
System_Ext(analytics, "Analytics Platform", "Product analytics (consented events)")

' --- clients -> edge
Rel(user, spa, "Uses", "HTTPS")
Rel(user, mobile, "Uses")
Rel(spa, gateway, "API calls", "HTTPS/JSON")
Rel(mobile, gateway, "API calls", "HTTPS/JSON")
Rel(spa, ws, "Real-time", "WSS")
Rel(mobile, ws, "Real-time", "WSS")
Rel(mobile, cdn, "Loads media", "HTTPS")
Rel_L(gateway, registry, "Resolves upstreams", "DNS SRV")

' --- edge -> services
Rel(gateway, userSvc, "/api/users")
Rel(gateway, postSvc, "/api/posts")
Rel(gateway, feedSvc, "/api/feed")
Rel(gateway, msgSvc, "/api/conversations")
Rel(gateway, mediaSvc, "/api/media")
Rel(gateway, searchSvc, "/api/search")
Rel(gateway, billingSvc, "/api/billing")

' --- synchronous service-to-service
Rel(feedSvc, userSvc, "Following", "HTTP + breaker")
Rel(feedSvc, postSvc, "Hydrate posts", "HTTP + breaker")
Rel(modSvc, postSvc, "Hide / remove content", "HTTP")
Rel(msgSvc, ws, "Live delivery")
Rel(notifSvc, ws, "Online delivery")

' --- events
Rel(userSvc, kafka, "user.*")
Rel(postSvc, kafka, "post.* (outbox)")
Rel(msgSvc, kafka, "message.sent")
Rel(billingSvc, kafka, "subscription.*")
Rel(feedSvc, kafka, "Consumes post.created, user.followed")
Rel(notifSvc, kafka, "Consumes interactions, messages")
Rel(searchSvc, kafka, "Consumes index updates")
Rel(modSvc, kafka, "Consumes new content")

' --- data
Rel(userSvc, pg, "SQL")
Rel(postSvc, pg, "SQL")
Rel(mediaSvc, pg, "Media metadata", "SQL")
Rel(modSvc, pg, "Reports, decisions", "SQL")
Rel(billingSvc, pg, "Subscriptions", "SQL")
Rel(feedSvc, redis, "Timelines", "RESP")
Rel(ws, redis, "Connection routing", "pub/sub")
Rel(feedSvc, cassandra, "Durable timelines", "CQL")
Rel(msgSvc, cassandra, "Messages", "CQL")
Rel(notifSvc, cassandra, "Notifications", "CQL")
Rel(searchSvc, es, "Index / query")
Rel(mediaSvc, s3, "Stores media")

' --- external systems
Rel(s3, cdn, "Origin for")
Rel(userSvc, oauth, "Sign-in", "OIDC")
Rel(notifSvc, push, "Offline delivery", "HTTPS")
Rel(billingSvc, payment, "Charges / webhooks", "HTTPS")
Rel(kafka, analytics, "Consented events", "Kafka Connect")

SHOW_LEGEND()
@enduml
